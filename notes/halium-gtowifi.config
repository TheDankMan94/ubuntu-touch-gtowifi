# Kernel config fragment for gtowifi (Halium 9). UNTESTED: not yet merged or built.
# Merge on top of arch/arm64/configs/lineageos_gtowifi_defconfig with
#   scripts/kconfig/merge_config.sh (kernel/samsung/sdm429), then re-run
#   halium/halium-boot/check-kernel-config on the resulting .config.
#
# --- Reported "not set, set it" by Halium's check-kernel-config on the running kernel ---
CONFIG_AUTOFS4_FS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_BLK_CGROUP=y
CONFIG_CGROUP_PERF=y
CONFIG_SYSVIPC=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_AUDITSYSCALL=y
CONFIG_AUDIT_TREE=y
CONFIG_AUDIT_WATCH=y
# CONFIG_RTC_DRV_CMOS is an x86 driver; probably not applicable on arm64. Check, likely drop.
# CONFIG_CGROUP_MEM_RES_CTLR* are legacy names for MEMCG, which is already =y here.

# --- Found missing by manual comparison with the running config (not covered by the script) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_FHANDLE=y
CONFIG_POSIX_MQUEUE=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_NET_PRIO=y
CONFIG_VETH=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XATTR=y
CONFIG_SQUASHFS_XZ=y

# --- AppArmor (needs verifying against SELinux LSM stacking on 4.9) ---
CONFIG_SECURITY_APPARMOR=y
CONFIG_DEFAULT_SECURITY_APPARMOR=y
CONFIG_SECURITY_APPARMOR_HASH=y

# Old tree GCC 4.9 binutils cannot link the 32-bit vDSO ("Not enough room for program headers");
# 32-bit processes fall back to normal syscalls for clock_gettime.
# CONFIG_COMPAT_VDSO is not set

# Virtual terminals: Mir/unity-system-compositor needs a VT ("Failed to find the current VT");
# Halium check-kernel-config wants VT, VT_CONSOLE, CONSOLE_TRANSLATIONS on and keeps
# the framebuffer text console off so the display stays free for Mir.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y
CONFIG_CONSOLE_TRANSLATIONS=y
# CONFIG_VT_HW_CONSOLE_BINDING is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# Bluetooth for Ubuntu Touch: bluebinder needs /dev/vhci; BlueZ needs BR/EDR, LE, RFCOMM, BNEP, HIDP
CONFIG_BT_BREDR=y
CONFIG_BT_LE=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
CONFIG_BT_HCIVHCI=y
